# MongoDB Atlas connection string. Never commit your real URI or database password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=mysterybox
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Use a long random value (at least 32 characters) in production.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3000
NODE_ENV=development
