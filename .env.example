# Copy this file to .env for local development.
# In Render, add these as Environment Variables instead of uploading .env.
MONGO_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster-host>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development
